# Скопіюйте у .env та заповніть власними значеннями.
# .env у git НЕ потрапляє (див. .gitignore).

# ── LLM-провайдер (потрібен один із двох) ────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── База даних ───────────────────────────────────────────
# Локально (docker compose) значення підставляється автоматично.
# На сервері — база, створена в aaPanel → Databases → PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME

# ── CORS ─────────────────────────────────────────────────
# Домени, з яких дозволені запити до API.
CORS_ORIGINS=http://localhost:5199,https://demax.kindrakevich.com
